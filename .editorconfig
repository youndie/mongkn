# Стиль задаётся здесь, а не умолчаниями плагина: иначе правила поедут при его обновлении,
# а не когда мы этого захотим.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# 120, а не умолчательные 140: код и так писался под ~100, и запас нужен на длинные
# идентификаторы cinterop, а не на многоэтажные выражения.
max_line_length = 120
ktlint_code_style = ktlint_official

[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2
