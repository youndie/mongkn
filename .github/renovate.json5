{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name. What this file used to spell out — the
  // timezone, the Monday schedule, the limits, the kotlin/kotlinx/sborka/ci-actions groups, majors
  // going to a human — was identical in ten repositories and now lives in sborka.
  //
  // THE AUTOMERGE PRESET IS DELIBERATELY NOT HERE, AND THAT IS STILL THE DIFFERENCE FROM THE
  // SIBLINGS. `github>youndie/sborka:automerge-harness` lets the build harness merge itself on the
  // argument that CI on `pull_request` is the review. In this repository there is no such review:
  // build.yml and publish.yml are `workflow_dispatch` only — checked again while migrating this
  // file, not assumed — so a pull request here carries no check at all. A green-looking pull
  // request means nobody ran anything, and automerge would turn that into "nobody ever will".
  extends: ["github>youndie/sborka"],

  // Lower than the preset's 5, and for the reason above: with nothing merging itself, this number
  // throttles human attention rather than runner time.
  prConcurrentLimit: 3,

  // Below the extends, so these win: package rules are concatenated, preset first, last match
  // takes effect.
  packageRules: [
    {
      description: "ktlint is build tooling, not a runtime dependency",
      matchPackageNames: [
        // The Gradle plugin is named by its id, with nothing after it — a pattern that demands a
        // `:` or a `.` next matches the coordinate and misses the plugin entirely.
        "org.jlleitschuh.gradle.ktlint",
        "/^com\\.pinterest\\.ktlint[:.]/",
      ],
      matchUpdateTypes: ["minor", "patch"],
      // Redundant while nothing automerges here, and kept on purpose: it is what would keep ktlint
      // out of an automerge preset if one is ever added, and the sentence above is why.
      automerge: false,
    },
    {
      // The JDK the CI image carries is what the cinterop build runs against, and no check on a
      // pull request builds this file.
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      additionalBranchPrefix: "docker-",
    },
    {
      // The whole point of this repository is which mongo-c-driver branch is exercised, and the
      // server the tests run against is half of that pair. A new major of the server is a decision
      // about what is being tested, and it is taken by reading, not by merging.
      description: "The test server is the subject of the tests, not a dependency of them",
      matchManagers: ["docker-compose"],
      additionalBranchPrefix: "stand-",
      labels: ["dependencies", "test server"],
    },
  ],
}
